APP_NAME=MDGenerator
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# SPA dan API kini berjalan di satu origin (Laravel melayani build dari
# public/build). Dev server Vite memakai proxy ke VITE_DEV_BACKEND, jadi nilai
# ini tetap benar baik saat `npm run dev` maupun saat build disajikan Laravel.
FRONTEND_URL=http://localhost:8000
API_FRONTEND_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mdgenerator
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Masuk dengan Google -----------------------------------------------
# Isi dari Google Cloud Console > Credentials > OAuth 2.0 Client (Web app).
# Authorized redirect URI yang didaftarkan harus persis sama dengan nilai
# GOOGLE_REDIRECT_URI di bawah, dan host-nya harus sama dengan host yang
# Anda pakai di browser (localhost dan 127.0.0.1 dianggap berbeda).
# Kosongkan keduanya untuk menyembunyikan tombol Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Frontend (Vite) -----------------------------------------------------
# SPA kini satu origin dengan API, jadi VITE_API_URL biasanya DIBIARKAN KOSONG
# dan aplikasi memakai path relatif. Hanya isi kalau API sengaja dipisah ke
# host lain (mis. http://localhost:8000).
# VITE_DEV_BACKEND hanya dipakai `npm run dev` oleh proxy di vite.config.ts.
VITE_API_URL=
VITE_DEV_BACKEND=http://localhost:8000
# -------------------------------------------------------------------------

# --- Notifikasi WhatsApp (Starsender) ----------------------------------
# Mengirim pesan ke grup saat ada pendaftaran baru dan setiap perubahan
# status pesanan kredit. Isi STARSENDER_GROUP dengan nama grup persis
# seperti di WhatsApp (mis. KERJAAN) dan pastikan bot sudah jadi anggota
# grup tersebut. Kosongkan salah satu nilainya untuk mematikan pengiriman.
STARSENDER_API_KEY=
STARSENDER_GROUP=
# ------------------------------------------------------------------------

# AI provider layer. Keep secrets server-side only (AGENTS.md §18).
#
# AI_DEFAULT_PROVIDER picks the driver: mock | openai | gemini | openrouter | gateway
#   - mock      : deterministic stand-in, needs no key (good for local/tests)
#   - openai    : uses OPENAI_API_KEY / OPENAI_MODEL
#   - gemini    : uses GEMINI_API_KEY / GEMINI_MODEL
#   - openrouter: uses OPENROUTER_API_KEY / OPENROUTER_MODEL
#   - gateway   : any endpoint that speaks the OpenAI Chat Completions contract
AI_DEFAULT_PROVIDER=mock
AI_TIMEOUT_SECONDS=60

# Any gateway that speaks the OpenAI Chat Completions contract.
AI_GATEWAY_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_GATEWAY_KEY=
AI_GATEWAY_MODEL=gpt-4o-mini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Domain yang boleh memakai cookie sesi Sanctum. SPA kini same-origin, jadi
# 8000 sudah cukup; 5173 didaftarkan untuk `npm run dev` yang memakai proxy.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000,localhost:5173,127.0.0.1:5173

# Manual bank transfer (no payment gateway). The account details are read from
# the server and shown to the user on /app/payments — they are never bundled.
# An admin must approve each transfer before credits are granted.
MD_BANK_NAME=BCA
MD_BANK_ACCOUNT=1234567890
MD_BANK_HOLDER="PT MD Generator"
MD_BANK_INSTRUCTIONS="Transfer sesuai nominal tepat sampai 3 digit terakhir, lalu isi nomor referensi/berita transfer di halaman ini."
MD_PAYMENT_EXPIRY_HOURS=24

# Pakasir payment gateway (optional second rail). Leave PAKASIR_SLUG or
# PAKASIR_API_KEY empty to hide the option entirely. Both values, plus the
# webhook secret, live at the bottom of the project page on app.pakasir.com.
# While PAKASIR_SANDBOX=true no real money moves; a sandbox transaction must be
# simulated (button on /app/payments) before Pakasir sends its webhook.
# Webhook URL to register: {APP_URL}/api/pakasir/webhook
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=
PAKASIR_SANDBOX=true
PAKASIR_METHOD=payment_link

# Generation rate limit (P1-7). A generation spends external AI quota, so these
# ceilings protect the bill. Per user, then a looser per-IP backstop.
MD_GENERATIONS_PER_MINUTE=10
MD_GENERATIONS_PER_MINUTE_IP=30

# Database queue reclaim window in seconds (P1-6). MUST stay above
# RunGenerationJob::$timeout (150s) + AI_TIMEOUT_SECONDS, otherwise a job still
# running is released back to the queue and can run twice (double AI call,
# double refund).
DB_QUEUE_RETRY_AFTER=330

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
