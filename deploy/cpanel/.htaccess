# MDGenerator — public_html/.htaccess untuk deploy cPanel
# ---------------------------------------------------------
# Letakkan file ini di public_html/ TOGETHER with index.php dari deploy/cpanel/.
# Document root tetap public_html (domain utama); kode aplikasi ada di
# /home/USER/mdgenerator (di luar webroot).
#
# Yang dilakukan file ini:
#   1. /build/*  -> build/*  (aset JS/CSS hasil npm run build, statis)
#   2. /storage/*-> storage/* (hanya ada di Opsi B yang memakai storage:link)
#   3. lainnya   -> index.php  (Laravel melayani shell SPA + /api/*)
#   4. CSS/JS/font di-cache agresif; index.html tidak.
#   5. Blokir akses ke file sensitif (.env, .git, dsb) sekadar berjaga-jaga.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /build/asset.js dan teman-temannya: tetap statis, tidak lewat PHP.
    RewriteRule ^build/(.*)$ build/$1 [L]

    # Hanya dipakai di Opsi B (storage:link di public/storage).
    RewriteRule ^storage/(.*)$ storage/$1 [L]

    # Semua URL lain masuk ke front controller Laravel.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# --- Aset build: cache satu tahun (nama file ber-hash) ---
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # index.html TIDAK boleh di-cache: isinya nama file aset yang berubah.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Gzip (hosting lama kadang belum menyalakan brotli) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- Sekadar jaga-jaga kalau ada file sensitif tercecer di public_html ---
<FilesMatch "^\.env|\.git|composer\.(json|lock)">
    Require all denied
</FilesMatch>

# PHP: upload bukti transfer butuh minimal 8M.
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 8M
</IfModule>
